{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "skyrim-party-sheet",
  "version-string": "0.0.1",
  "dependencies": [
    "directxmath",
    "directxtk",
    "directxtex",
    "fmt",
    {
      "name": "imgui",
      "features": [
        "dx11-binding",
        "win32-binding",
        "freetype",
        "wchar32"
      ]
    },
    "lunasvg",
    "nlohmann-json",
    "rapidcsv",
    "simpleini",
    "spdlog",
    "toml11",
    "xbyak"
  ],
  "overrides": [
    { "name": "directxmath", "version": "2025-04-03" },
    { "name": "directxtk", "version": "2025-10-27" },
    { "name": "directxtex", "version": "2025-10-27" },
    { "name": "fmt", "version": "12.1.0" },
    { "name": "spdlog", "version": "1.16.0" },
    { "name": "freetype", "version": "2.13.3" },
    { "name": "plutovg", "version": "1.3.2" },
    { "name": "nlohmann-json", "version": "3.12.0#1" },
    { "name": "rapidcsv", "version": "8.90" },
    { "name": "simpleini", "version": "4.25" }
  ]
}